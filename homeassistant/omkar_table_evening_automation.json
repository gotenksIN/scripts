{
  "alias": "Omkar Table Evening Auto",
  "description": "When sun elevation drops below 10, set table lights to 60% at 5000K when person is home.",
  "triggers": [
    {
      "platform": "numeric_state",
      "entity_id": "sun.sun",
      "attribute": "elevation",
      "below": 10
    },
    {
      "platform": "homeassistant",
      "event": "start"
    },
    {
      "platform": "state",
      "entity_id": "person.omkar_chandorkar",
      "to": "home"
    }
  ],
  "conditions": [
    {
      "condition": "state",
      "entity_id": "light.table",
      "state": "off"
    },
    {
      "condition": "template",
      "value_template": "{% set elevation = state_attr('sun.sun', 'elevation') | float(90) %}{{ elevation > 0 and elevation < 10 and not state_attr('sun.sun', 'rising') }}"
    },
    {
      "condition": "state",
      "entity_id": "person.omkar_chandorkar",
      "state": "home"
    }
  ],
  "actions": [
    {
      "action": "script.turn_on",
      "target": { "entity_id": "script.omkar_table_evening" }
    }
  ],
  "mode": "single"
}
