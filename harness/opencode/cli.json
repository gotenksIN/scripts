{
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "session": {
    "thinking": "show",
    "scrollbar": true,
    "grouping": "auto",
    "image_preview": true,
    "new_location": "launch"
  },
  "animations": true,
  "cursor": {
    "style": "line"
  },
  "tabs": {
    "enabled": true,
    "scope": "global",
    "layout": "vertical"
  },
  "diffs": {
    "tree": true
  },
  "keybinds": {
    "session.first": "ctrl+q",
    "session.last": "ctrl+e",
    "input.buffer.home": "home",
    "input.buffer.end": "end"
  }
}
