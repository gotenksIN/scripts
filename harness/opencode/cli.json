{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "session": {
    "thinking": "show",
    "scrollbar": true,
    "grouping": "auto",
    "image_preview": true,
    "new_location": "launch",
    "sidebar": "hide",
    "terminal": true,
    "tps": true
  },
  "animations": true,
  "cursor": {
    "style": "line"
  },
  "tabs": {
    "enabled": true,
    "scope": "global",
    "layout": "vertical",
    "indicators": "status"
  },
  "diffs": {
    "tree": true
  },
  "keybinds": {
    "session.first": "ctrl+q",
    "session.last": "ctrl+e",
    "input.buffer.home": "home",
    "input.buffer.end": "end",
    "prompt.queue": "alt+enter"
  },
  "prompt": {
    "image_preview": true
  },
  "terminal": {
    "title": true,
    "copy": "manual"
  },
  "debug": {
    "devtools": false,
    "timing": false,
    "turn_tokens": false
  },
  "experimental": {
    "session-preview-tabs": false
  }
}
