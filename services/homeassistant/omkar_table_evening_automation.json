{
  "id": "omkar_table_evening_auto",
  "alias": "Omkar Table Evening Auto",
  "description": "Between 10° and -4° descending sun elevation, set table lights to 60% at 5000K when person is home and lights are off.",
  "triggers": [
    {
      "trigger": "numeric_state",
      "entity_id": "sun.sun",
      "attribute": "elevation",
      "below": 10
    },
    {
      "trigger": "homeassistant",
      "event": "start"
    },
    {
      "trigger": "state",
      "entity_id": "person.omkar_chandorkar",
      "from": "not_home",
      "to": "home"
    },
    {
      "trigger": "state",
      "entity_id": "light.table",
      "from": [
        "unavailable",
        "unknown"
      ],
      "to": "off",
      "for": "00:00:05"
    }
  ],
  "conditions": [
    {
      "condition": "state",
      "entity_id": "light.table",
      "state": "off"
    },
    {
      "condition": "template",
      "value_template": "{% set elevation = state_attr('sun.sun', 'elevation') | float(90) %}{{ elevation >= -4 and elevation < 10 and not state_attr('sun.sun', 'rising') }}"
    },
    {
      "condition": "state",
      "entity_id": "person.omkar_chandorkar",
      "state": "home"
    }
  ],
  "actions": [
    {
      "action": "script.turn_on",
      "target": {
        "entity_id": "script.omkar_table_evening"
      }
    }
  ],
  "mode": "single"
}
